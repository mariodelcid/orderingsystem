generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Customer orders placed on the kiosk tablet
model KioskOrder {
  id         Int              @id @default(autoincrement())
  number     Int // order number shown to the customer (resets daily)
  createdAt  DateTime         @default(now())
  status        String           @default("pending") // pending (cash, at dispatch) | awaiting_card (kiosk, in Square) -> charged -> done | cancelled
  note          String?
  totalCents    Int              @default(0)
  paymentMethod String? // cash | credit (set when charged)
  posSaleId     Int? // sale id created in the POS (texasstores)
  posError      String? // set if the card was paid in Square but recording the sale in the POS failed
  squareTxId    String? // Square transaction id for card payments made at the kiosk
  items      KioskOrderItem[]
}

model KioskOrderItem {
  id             Int        @id @default(autoincrement())
  orderId        Int
  order          KioskOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemName       String // POS item name
  qty            Int        @default(1)
  priceCents     Int        @default(0) // unit price shown/charged (promo-aware)
  lineTotalCents Int        @default(0)
}

// Manager-defined promotions shown on the kiosk
model Promo {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  itemName    String // POS item this promo applies to
  pctOff      Float? // % discount, OR
  priceCents  Int? // fixed promo price in cents
  imageId     Int?
  featured    Boolean @default(true) // show in the top promo strip
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
}

// Per-item extras managed here (photo, visibility) without touching the POS
model ItemInfo {
  id          Int     @id @default(autoincrement())
  itemName    String  @unique
  imageId     Int?
  hidden      Boolean @default(false)
  description String? // shown in the kiosk popup when the customer taps the item
  costCents   Int? // manager-entered unit cost, used for profit on the Ventas page
}

// Uploaded pictures, stored in the database (survives redeploys)
model Image {
  id        Int      @id @default(autoincrement())
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

// Sales ledger kept HERE (never in texasstores). One row per charged order or manual sale.
model Sale {
  id            Int        @id @default(autoincrement())
  createdAt     DateTime   @default(now())
  orderId       Int?       @unique // kiosk order this sale came from (null = manual sale at the Caja)
  orderNumber   Int?
  source        String     @default("dispatch") // dispatch | kiosk_card | caja
  paymentMethod String // cash | credit
  subtotalCents Int        @default(0) // at regular menu prices
  discountCents Int        @default(0) // promos
  totalCents    Int        @default(0) // what the customer paid
  costCents     Int        @default(0) // sum of item costs at time of sale
  tenderedCents Int? // cash received (cash sales)
  changeCents   Int? // change given back
  squareTxId    String?
  voided        Boolean    @default(false)
  voidedAt      DateTime?
  voidReason    String?
  items         SaleItem[]
}

model SaleItem {
  id             Int    @id @default(autoincrement())
  saleId         Int
  sale           Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemName       String
  category       String?
  qty            Int    @default(1)
  listPriceCents Int    @default(0) // regular price
  priceCents     Int    @default(0) // price actually charged per unit
  lineTotalCents Int    @default(0)
  unitCostCents  Int    @default(0)
}

// ================= Costos y Ganancias (clone of texas-stores-management) =================
// Same data model as the management site; sales come from this app's own Sale ledger.

// Raw materials / packaging / disposables
model Ingredient {
  id             Int       @id @default(autoincrement())
  code           String    @unique // e.g. "1001", "2002", "3014"
  name           String
  unit           String? // oz | each
  purchaseUnits  Float? // units per purchase (PU)
  pricePerPU     Float? // $ per purchase
  costPerUnit    Float     @default(0) // $ per unit (oz/each)
  provider1      String?
  provider1Price Float?
  provider2      String?
  provider2Price Float?
  provider3      String?
  provider3Price Float?
  stockOnHand    Float? // last physical count
  countedAt      DateTime? // when the count was taken
  bomLines       BomLine[]
}

// Final products (4xxx codes)
model Product {
  id         Int       @id @default(autoincrement())
  code       String    @unique // e.g. "4001"
  name       String
  priceCents Int? // reference sell price (actual sale price wins for revenue)
  bomLines   BomLine[]
  posMaps    PosMap[]
}

// One component line of a product's recipe
model BomLine {
  id            Int        @id @default(autoincrement())
  productId     Int
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId  Int
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  componentType String? // Ingredient | Packaging | Disposable
  quantity      Float      @default(0)
}

// Prepared mixes (their cost/oz feeds an Ingredient row)
model Mix {
  id                   Int       @id @default(autoincrement())
  name                 String    @unique
  linkedIngredientCode String?
  lines                MixLine[]
}

model MixLine {
  id            Int     @id @default(autoincrement())
  mixId         Int
  mix           Mix     @relation(fields: [mixId], references: [id], onDelete: Cascade)
  componentName String
  oz            Float?
  cost          Float?
}

// Maps a menu item name (as sold here) to a product BOM
model PosMap {
  id        Int      @id @default(autoincrement())
  posName   String   @unique
  kind      String   @default("product") // product | zerocost | ignore
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}
